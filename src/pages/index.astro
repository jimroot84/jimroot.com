---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoTile from '../components/PhotoTile.astro';
import Subscribe from '../components/Subscribe.astro';
import Contact from '../components/Contact.astro';
import site from '../data/site.json';
import { getPhotos, img, formatDate } from '../lib/photos';

const photos = await getPhotos();
const hero = photos.find((p) => p.pinned) ?? photos[0];
const count = Number(site.homepage_photo_count) || 10;
const rest = photos.filter((p) => p !== hero).slice(0, count);
// Repeating mosaic: wide-left row, three across, wide-right row, three across.
const tileClass = (i: number) => (i % 10 === 0 ? 'wide' : i % 10 === 6 ? 'wide' : '');
const heroFull = hero ? await getImage({ src: hero.image, width: Math.min(hero.image.width, 2200), format: 'webp' }) : null;
const crew = site.crew;
---
<Base>
  <header class="intro">
    <h1>{site.intro_heading}</h1>
    <p>{site.intro}</p>
  </header>

  {hero && heroFull && (
    <section class="hero" aria-label={hero.pinned ? 'Featured photo' : 'Latest photo'}>
      <Image
        src={hero.image}
        alt={hero.alt}
        widths={[800, 1200, 1600, 2200]}
        sizes="(min-width: 900px) calc(100vw - 352px), 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
      <a
        class="hero-full"
        href={heroFull.src}
        data-lightbox
        data-title={hero.location}
        data-caption={hero.caption}
        data-date={formatDate(hero.date)}
        data-alt={hero.alt}
      >
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
        View full size
      </a>
      <div class="hero-cap">
        <div class="hero-label">
          <span class="label">{hero.pinned ? 'Featured photo' : 'Latest photo'}</span>
          {hero.date && <span class="mono hero-date">{formatDate(hero.date)}</span>}
        </div>
        <h2>{hero.location}</h2>
        {hero.caption && <p>{hero.caption}</p>}
      </div>
    </section>
  )}

  <div class="duo">
    <section id="about" class="about card">
      <Image src={img(site.about_photo)} alt={`${site.name} and ${crew.name} at an overlook`} widths={[400, 700, 1000]} sizes="(min-width: 900px) 320px, 100vw" class="about-img" />
      <div class="about-body">
        <div class="label">About</div>
        <h2>{site.about_heading}</h2>
        <p>{site.about}</p>
        <ul class="tags">
          {site.about_tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <section id="crew" class="crew card">
      <Image src={img(crew.photo)} alt={`${crew.name}, smiling`} widths={[400, 700, 1000]} sizes="(min-width: 900px) 360px, 100vw" class="crew-img" />
      <div class="crew-body">
        <div class="label">The crew</div>
        <div class="crew-head">
          <h2>{crew.name}</h2>
          <span class="crew-title">{crew.title}</span>
        </div>
        <p>{crew.bio}</p>
        <dl class="flock">
          <div><dt>Chickens</dt><dd>{crew.chickens}</dd></div>
          <div><dt>Roosters</dt><dd>{crew.roosters}</dd></div>
          <div><dt>Ducks</dt><dd>{crew.ducks}</dd></div>
        </dl>
      </div>
    </section>
  </div>

  {rest.length > 0 && (
    <section class="roll" aria-labelledby="roll-h">
      <div class="section-head">
        <h2 id="roll-h">Camera Roll</h2>
        <a href="/camera-roll/">See the full roll →</a>
      </div>
      <div class="mosaic">
        {rest.map((p, i) => (
          <PhotoTile
            photo={p}
            class={tileClass(i)}
            sizes={tileClass(i) ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 30vw, 100vw'}
          />
        ))}
      </div>
    </section>
  )}

  <Subscribe />
  <Contact />
</Base>

<style>
  .intro { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
  .intro h1 { font-size: clamp(34px, 5vw, 44px); line-height: 1.08; font-weight: 800; letter-spacing: -0.035em; }
  .intro p { font-size: 18px; line-height: 1.55; color: var(--muted); }

  .hero { position: relative; height: clamp(380px, 52vw, 560px); border-radius: 18px; overflow: hidden; border: 1px solid var(--border); background: #1a1c20; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-full {
    position: absolute; top: 16px; right: 16px; display: inline-flex; align-items: center; gap: 8px;
    min-height: 40px; padding: 0 14px; border-radius: 999px; background: rgba(10, 11, 13, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.14); color: var(--text); text-decoration: none; font-size: 13px; font-weight: 600;
  }
  .hero-cap {
    position: absolute; left: 16px; bottom: 16px; right: 16px; max-width: 460px;
    padding: 18px 22px; border-radius: 12px; background: rgba(10, 11, 13, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.08); display: flex; flex-direction: column; gap: 8px;
  }
  .hero-label { display: flex; align-items: center; gap: 10px; }
  .hero-date { font-size: 12px; color: var(--muted); }
  .hero-cap h2 { font-size: clamp(22px, 3vw, 28px); line-height: 1.1; font-weight: 800; letter-spacing: -0.025em; }
  .hero-cap p { font-size: 15px; line-height: 1.5; color: #c9ccd3; }

  /* About + crew: stacked on narrow screens, side by side on wide ones */
  .duo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .about { min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; }
  .about-img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 30%; }
  .about-body { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .about-body h2 { font-size: 26px; line-height: 1.15; font-weight: 800; letter-spacing: -0.025em; }
  .about-body p { font-size: 15px; line-height: 1.65; color: var(--muted); }
  .tags { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 8px; background: var(--chip); }

  .crew { min-width: 0; overflow: hidden; display: flex; flex-direction: column; }
  .crew-img { width: 100%; height: auto; aspect-ratio: 4 / 3; max-height: 440px; object-fit: cover; object-position: 50% 60%; }
  @media (min-width: 640px) {
    /* photo beside text; the photo fills the card's full height */
    .about { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
    .about-img { height: 100%; aspect-ratio: auto; min-height: 380px; }
  }
  @media (min-width: 640px) and (max-width: 1399px) {
    .crew { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
    .crew-img { height: 100%; aspect-ratio: auto; max-height: none; min-height: 340px; }
  }
  @media (min-width: 1400px) {
    .duo { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .about-body { justify-content: center; }
  }
  .crew-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .crew-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .crew-head h2 { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
  .crew-title { font-size: 13px; font-weight: 600; color: var(--muted); }
  .crew-body p { font-size: 14px; line-height: 1.6; color: var(--muted); }
  .flock { margin: auto 0 0; display: flex; border-top: 1px solid var(--border); padding-top: 14px; }
  .flock div { flex: 1; display: flex; flex-direction: column-reverse; gap: 2px; padding-left: 14px; border-left: 1px solid var(--border); }
  .flock div:first-child { padding-left: 0; border-left: 0; }
  .flock dt { font-size: 13px; color: var(--muted); }
  .flock dd { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }

  .roll { display: flex; flex-direction: column; gap: 14px; }
  .roll .section-head a { color: var(--accent); }
  .mosaic { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .mosaic :global(.tile) { aspect-ratio: 4 / 3; }
  @media (min-width: 700px) {
    .mosaic { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: 300px; }
    .mosaic :global(.tile) { aspect-ratio: auto; grid-column: span 2; }
    .mosaic { grid-auto-flow: dense; }
    .mosaic :global(.wide) { grid-column: span 4; }
  }
</style>
